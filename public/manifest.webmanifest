{
  "name": "AetherEngine Studio",
  "short_name": "Aether Studio",
  "description": "Build, collaborate, and publish games directly from your browser.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "any",
  "background_color": "#090d16",
  "theme_color": "#090d16",
  "categories": ["games", "productivity", "developer"],
  "icons": [
    {
      "src": "/aether-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Open Studio Editor",
      "short_name": "Editor",
      "url": "/?mode=editor&source=pwa-shortcut",
      "icons": [{ "src": "/aether-icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Mobile Live Runtime",
      "short_name": "Live Test",
      "url": "/?mode=mobile&room=eldoria-main&source=pwa-shortcut",
      "icons": [{ "src": "/aether-icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ]
}
